<?xml version="1.0" encoding="utf-8"?>
<!--
    Rider Intercom, merged into Navigator as a library module.

    Differences from the standalone app's manifest, all forced by being a library
    inside someone else's application:

    - No <application android:name>. Navigator owns the one Application; the
      intercom's process-wide state lives in the RiderIntercomApp object instead.
    - No LAUNCHER intent filter and no app icon. Navigator opens the intercom from
      its own home screen, so a second launcher icon would just be confusing.
    - MainActivity is not exported: only Navigator starts it.
    - The microphone is required="false". A library's uses-feature merges into the
      host, so required="true" here would make Play hide Navigator itself from any
      device it considers mic-less - for an optional feature. The intercom checks
      the RECORD_AUDIO grant at runtime anyway.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Bluetooth: Android 12+ ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- ===== Bluetooth: legacy, Android 10-11 ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- ===== Wi-Fi Direct: the long-range transport and its discovery ===== -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi Direct carries voice over ordinary sockets, which need INTERNET even
         though no traffic ever leaves the two phones. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ===== Audio ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ===== Service lifetime ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <application>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RiderIntercom"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <service
            android:name=".call.IntercomService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone|connectedDevice|mediaPlayback" />

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
